{
  "name": "mome",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development MOME_DEV_TOOLS=1 vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "tsc --noEmit && vite build",
    "build:docker": "bun run build && bun build scripts/migrate.mjs --target=bun --external libsql --outfile=.output/server/migrate.mjs && cp -R drizzle .output/drizzle",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-presigned-post": "^3.1106.0",
    "@cloudflare/kumo": "^2.9.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.22",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "1.168.39",
    "better-auth": "^1.5.3",
    "drizzle-orm": "^0.45.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.20.0",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
