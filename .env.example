# ── 数据库 ─────────────────────────────────────────────
# 本地开发用 file: SQLite；生产可无缝切 Turso（libsql://xxx.turso.io）
DATABASE_URL="file:./local.db"
# 仅远端 Turso 需要
DATABASE_AUTH_TOKEN=

# ── Better Auth ────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
# 生成：bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=

# ── 管理员 ─────────────────────────────────────────────
# 站点还没有管理员时，已登录用户访问 /admin 并输入此令牌即可成为首位管理员。
# 管理员产生后，普通用户访问 /admin 会被拒绝。
# 生成高熵令牌：openssl rand -base64 32（至少 128 位熵，勿使用短口令）
ADMIN_TOKEN=

# ── 开发工具（绝不要在生产设置）─────────────────────────
# 开启 /api/dev-otp 接口（读取最近一次 OTP，仅本地调试使用）。
# 注意：该接口要求 NODE_ENV=development 才会生效（fail-closed），
# 生产/未设置 NODE_ENV 恒 404。dev 脚本已默认带上。
# MOME_DEV_TOOLS=1

# ── 邮件（按优先级：SMTP → Resend → 控制台日志） ────────
# 未配置 SMTP / Resend 时，注册邮箱验证、OTP 登录、更换邮箱功能自动关闭。
# 本地调试可显式开启控制台模式（仅开发环境）：
# MOME_EMAIL_DEV=console
# SMTP 发信（推荐）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="mome <noreply@example.com>"
# 或 Resend API
RESEND_API_KEY=
RESEND_FROM=

# ── S3 兼容对象存储（头像 / memo 图片） ─────────────────
# 未配置时上传图片功能自动关闭（头像仍可使用图片 URL）
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 公开访问地址（可选，默认取 S3_ENDPOINT/BUCKET）
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
